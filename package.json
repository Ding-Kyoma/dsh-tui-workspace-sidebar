{
  "name": "dsh-tui-workspace-sidebar",
  "version": "0.1.3",
  "description": "Right-side inbox sidebar for dsh-TUI: running, unread and recent conversations grouped by workspace",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./copy": "./copy.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "model.js",
    "tracker.js",
    "store.js",
    "panel.js",
    "copy.js",
    "jump.js",
    "questions.js",
    "current.js",
    "strings.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test": "node --test",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check": "npm test && npm run check:manifest",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ding-Kyoma/dsh-tui-workspace-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/Ding-Kyoma/dsh-tui-workspace-sidebar/issues"
  },
  "homepage": "https://github.com/Ding-Kyoma/dsh-tui-workspace-sidebar#readme",
  "author": "Ding-Kyoma (https://github.com/Ding-Kyoma)",
  "keywords": [
    "dsh",
    "dsh-tui",
    "dsh-plugin",
    "deepseek-harness",
    "tui",
    "sidebar",
    "inbox",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

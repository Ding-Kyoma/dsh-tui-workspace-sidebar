{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "manifestVersion": "0.15",
  "id": "workspace-sidebar",
  "name": "Workspace sidebar",
  "version": "0.1.4",
  "facets": {
    "host": {
      "entry": "index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "workspace-sidebar.ws",
      "reason": "Registers /ws, which opens the inbox panel."
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "workspace-sidebar.ws",
        "title": "Open inbox",
        "description": "Open the workspace inbox panel."
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/Ding-Kyoma/dsh-tui-workspace-sidebar"
  }
}
